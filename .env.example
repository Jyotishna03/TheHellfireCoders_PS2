# SmartFDR Environment Configuration
PORT=5001
NODE_ENV=development

# Simulated Core Banking Gateway
MOCK_BANK_PROVIDER=SIMULATED_CORE_BANKING_ADAPTER
MOCK_BANK_LATENCY_MS=600

# Document Vault Storage
UPLOAD_DIR=./server/uploads
MAX_FILE_SIZE_BYTES=15728640

# OCR Engine Settings
OCR_CONFIDENCE_THRESHOLD=75
OCR_ENGINE_FALLBACK=true

# Security & Governance
ENABLE_DEMO_SSO_SWITCHER=true
SESSION_EXPIRY_HOURS=12

